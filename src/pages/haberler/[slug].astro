---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import GoogleNewsBanner from '../../components/GoogleNewsBanner.astro';
import SocialShare from '../../components/SocialShare.astro';
import VideoWidget from '../../components/VideoWidget';
import SidebarSlider from '../../components/SidebarSlider.astro';
import { fetchParaAnalizVideos } from '../../lib/youtube';
import type { VideoItem } from '../../lib/youtube';
import { fetchNewsBySlug, fetchNewsList, fetchBlogList, resolveMediaUrl, lexicalToPlainText, lexicalToHtml, fetchFromPayload } from '../../lib/payload';
import type { NewsItem, BlogItem, NewsListResponse } from '../../lib/payload';

const { slug } = Astro.params;

let news: NewsItem | null = null;
let sliderSlides: NewsItem[] = [];
let blogs: BlogItem[] = [];
let ytVideos: VideoItem[] = [];
let error: string | null = null;

try {
  // Slider için 10 slayt (current news hariç) — ana fetch'lerle paralel çekilir
  const fetchSlider = () =>
    fetchFromPayload(`/api/news?limit=11&where[category][not_in][]=28&where[slug][not_equals]=${slug}`)
      .then((r) => (r as NewsListResponse).docs)
      .catch((err) => {
        console.error("Sidebar slider fetch error:", err);
        return [] as NewsItem[];
      });

  const [newsData, blogData, videos, sliderDocs] = await Promise.all([
    fetchNewsBySlug(slug!),
    fetchBlogList(1, 6),
    fetchParaAnalizVideos(),
    fetchSlider(),
  ]);

  news = newsData;
  ytVideos = videos;
  sliderSlides = sliderDocs.slice(0, 10);

  // Filter for unique authors for blog sidebar
  const uniqueAuthors = new Map<number, BlogItem>();
  blogData.docs.forEach(post => {
    if (post.author && !uniqueAuthors.has(post.author.id)) {
      uniqueAuthors.set(post.author.id, post);
    }
  });
  blogs = Array.from(uniqueAuthors.values()).slice(0, 6);

  if (!news) error = 'Haber bulunamadı.';
} catch (e) {
  error = e instanceof Error ? e.message : 'Haber yüklenemedi.';
}

const imageUrl = news?.featuredImage ? resolveMediaUrl(news.featuredImage.url) : null;
const description = news?.seo?.metaDescription ?? lexicalToPlainText(news?.body).slice(0, 160);
const shareUrl = "https://paraanaliz.com/haberler/" + slug;
const bodyHtml = news ? lexicalToHtml(news.body) : '';

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('tr-TR', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}

---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead
      title={news?.title ?? 'Haber'}
      description={description}
      image={imageUrl ?? undefined}
    />
    <style>
      .page-layout {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 3rem;
        margin-top: 2rem;
        align-items: start;
      }

      /* Main Column */
      .main-column {
        min-width: 0; /* Fix flex/grid overflow */
      }

      .hero-image {
        width: 100%;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      }
      .hero-image img {
        width: 100%;
        height: auto;
        display: block;
      }

      .article-header {
        margin-bottom: 2.5rem;
      }

      .category-tag {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--primary);
        letter-spacing: 0.1em;
        margin-bottom: 1rem;
      }

      h1 {
        font-size: 2.75rem;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.04em;
        color: var(--foreground);
        margin-bottom: 1.5rem;
        position: relative;
        padding-bottom: 1.5rem;
      }
      h1::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 80px;
        height: 6px;
        background: var(--primary);
        border-radius: 3px;
      }

      .excerpt {
        font-size: 1.25rem;
        line-height: 1.6;
        color: var(--muted-foreground);
        margin-bottom: 2rem;
        font-weight: 500;
        border-left: 4px solid var(--primary);
        padding-left: 1.5rem;
      }

      .meta-info {
        font-size: 0.85rem;
        color: var(--muted-foreground);
        font-weight: 600;
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .content {
        font-size: 1.15rem;
        line-height: 1.8;
        color: var(--foreground);
      }
      .content :global(p) { margin-bottom: 1.75rem; }
      .content :global(h2) { font-size: 1.8rem; font-weight: 800; margin: 2.5rem 0 1.25rem; }
      .content :global(img) { border-radius: 12px; margin: 2rem auto; display: block; max-width: 100%; }

      /* Sidebar */
      .sidebar {
        position: sticky;
        top: 6rem;
      }

      .sidebar-section {
        margin-bottom: 3rem;
      }

      .sidebar-title {
        font-size: 1.1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 3px solid var(--primary);
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
      }

      .sidebar-post {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.25rem;
        text-decoration: none;
        color: inherit;
        align-items: center;
      }
      .sidebar-post-img {
        width: 50px; height: 50px; border-radius: 50%; object-fit: cover; flex-shrink: 0;
        border: 2px solid var(--border);
      }
      .sidebar-post-content { flex: 1; }
      .sidebar-post-author { font-size: 0.7rem; font-weight: 700; color: var(--primary); text-transform: uppercase; }
      .sidebar-post-title { 
        font-size: 1.05rem; 
        font-weight: 700; 
        line-height: 1.3; 
        display: -webkit-box; 
        -webkit-line-clamp: 2; 
        -webkit-box-orient: vertical; 
        overflow: hidden; 
      }


      @media (max-width: 960px) {
        .page-layout { grid-template-columns: 1fr; gap: 2rem; }
        .sidebar { position: static; }
        h1 { font-size: 2rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="page-layout">
        <!-- Main Column -->
        <div class="main-column">
          {error && <p style="color:red">{error}</p>}
          {news && (
            <article>
              <div class="article-header">
                {news.category && news.category.id !== 28 && <span class="category-tag">{news.category.name}</span>}
                <h1>{news.title}</h1>
                {description && <div class="excerpt">{description}</div>}
                <div class="meta-info">
                  {news.publishedAt && <span>{formatDate(news.publishedAt)}</span>}
                </div>
                <SocialShare title={news.title} url={shareUrl} />
              </div>

              {imageUrl && (
                <div class="hero-image">
                  <img src={imageUrl} alt={news.title} />
                </div>
              )}

              <div class="content" set:html={bodyHtml} />

              <div style="margin: 4rem 0;">
                <GoogleNewsBanner />
              </div>

              <!-- Paraanaliz TV -->
              <div style="margin-top: 4rem; border-top: 1px solid var(--border); padding-top: 3rem;">
                <VideoWidget client:load initialVideos={ytVideos} />
              </div>
            </article>
          )}
        </div>

        <!-- Sidebar -->
        <aside class="sidebar">
          <!-- Sidebar Slider -->
          <SidebarSlider slides={sliderSlides} />

          <!-- Blog Yazıları -->
          <div class="sidebar-section">
            <h2 class="sidebar-title">Son Blog Yazıları</h2>
            {blogs.map(post => {
              const authorImg = post.author?.profilePhoto ? resolveMediaUrl(post.author.profilePhoto.url) : null;
              return (
                <a href={"/yazarlar/" + post.slug} class="sidebar-post">
                  {authorImg ? (
                    <img src={authorImg} alt={post.author?.name} class="sidebar-post-img" />
                  ) : (
                    <div class="sidebar-post-img" style="background:var(--border); display:flex; align-items:center; justify-content:center;">✍️</div>
                  )}
                  <div class="sidebar-post-content">
                    <p class="sidebar-post-author">{post.author?.name}</p>
                    <p class="sidebar-post-title">{post.title}</p>
                  </div>
                </a>
              )
            })}
          </div>
        </aside>
      </div>
    </main>
    <Footer />
  </body>
</html>
