---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { fetchNewsBySlug, resolveMediaUrl, lexicalToPlainText, lexicalToHtml } from '../../lib/payload';
import type { NewsItem } from '../../lib/payload';

// SSR mode — no getStaticPaths needed, every request fetches live data

const { slug } = Astro.params;

let news: NewsItem | null = null;
let error: string | null = null;

try {
  news = await fetchNewsBySlug(slug!);
  if (!news) error = 'Haber bulunamadı.';
} catch (e) {
  error = e instanceof Error ? e.message : 'Haber yüklenemedi.';
}

const imageUrl = news?.featuredImage ? resolveMediaUrl(news.featuredImage.url) : null;
const description = news?.seo?.metaDescription ?? lexicalToPlainText(news?.body).slice(0, 160);

const bodyHtml = news ? lexicalToHtml(news.body) : '';
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead
      title={news?.title ?? 'Haber'}
      description={description}
      image={imageUrl ?? undefined}
    />
    <style>
      .hero-image {
        width: 100%;
        margin-bottom: 2rem;
      }
      .hero-image img {
        width: 100%;
        max-height: 480px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
        display: block;
      }
      .article-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-size: 0.875rem;
        color: rgb(var(--gray));
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
      }
      .article-meta .category {
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--accent);
        font-size: 0.75rem;
      }
      .article-meta .author {
        font-weight: 600;
        color: rgb(var(--gray-dark));
      }
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .prose h1 { font-size: 2.5rem; margin-bottom: 1rem; }
      .prose h2 { font-size: 1.75rem; margin: 1.5rem 0 0.75rem; }
      .prose h3 { font-size: 1.4rem; margin: 1.25rem 0 0.5rem; }
      .prose p  { margin-bottom: 1.25rem; line-height: 1.8; }
      /* YouTube embed */
      .prose :global(.yt-embed) {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%; /* 16:9 */
        margin: 1.5rem 0;
        border-radius: 10px;
        overflow: hidden;
        background: #000;
      }
      .prose :global(.yt-embed iframe) {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        border: 0;
        border-radius: 10px;
      }
      .back-link {
        display: inline-block;
        margin-bottom: 2rem;
        color: var(--accent);
        font-size: 0.9rem;
        text-decoration: none;
      }
      .back-link:hover { text-decoration: underline; }
      .error-message {
        color: #c00;
        padding: 1rem;
        border: 1px solid #fcc;
        border-radius: 8px;
        background: #fff5f5;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="prose">
        <a href="/haberler" class="back-link">← Tüm Haberler</a>

        {error && <p class="error-message">⚠️ {error}</p>}

        {news && (
          <article>
            {imageUrl && (
              <div class="hero-image">
                <img
                  src={imageUrl}
                  alt={news.featuredImage?.alt ?? news.title}
                  width={news.featuredImage?.width ?? 1200}
                  height={news.featuredImage?.height ?? 675}
                />
              </div>
            )}

            <div class="article-meta">
              {news.category && <span class="category">{news.category.name}</span>}
              {news.author && <span class="author">{news.author.name}</span>}
            </div>

            <h1>{news.title}</h1>

            {description && (
              <p style="color: rgb(var(--gray)); font-style: italic; margin-bottom: 1.5rem;">
                {description}
              </p>
            )}

            <hr />

            <div set:html={bodyHtml} />
          </article>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>
