---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { fetchNewsBySlug, fetchNewsList, resolveMediaUrl, lexicalToPlainText, lexicalToHtml } from '../../lib/payload';
import type { NewsItem } from '../../lib/payload';

// SSR mode — no getStaticPaths needed, every request fetches live data

const { slug } = Astro.params;

let news: NewsItem | null = null;
let latestNews: NewsItem[] = [];
let error: string | null = null;

try {
  const [newsData, latestData] = await Promise.all([
    fetchNewsBySlug(slug!),
    fetchNewsList(1, 11) // Fetch 11 to account for current post
  ]);
  
  news = newsData;
  latestNews = latestData.docs.filter(item => item.slug !== slug).slice(0, 10);
  
  if (!news) error = 'Haber bulunamadı.';
} catch (e) {
  error = e instanceof Error ? e.message : 'Haber yüklenemedi.';
}

const imageUrl = news?.featuredImage ? resolveMediaUrl(news.featuredImage.url) : null;
const description = news?.seo?.metaDescription ?? lexicalToPlainText(news?.body).slice(0, 160);

const bodyHtml = news ? lexicalToHtml(news.body) : '';
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead
      title={news?.title ?? 'Haber'}
      description={description}
      image={imageUrl ?? undefined}
    />
    <style>
      .hero-image {
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        margin-bottom: 2.5rem;
        overflow: hidden;
      }
      .hero-image img {
        width: 100%;
        max-height: 600px;
        object-fit: cover;
        display: block;
      }
      .prose {
        width: 720px;
        max-width: 100%;
        margin: auto;
        padding: 0 1.25rem 4rem;
      }
      .article-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.9rem;
        color: var(--muted-foreground);
        margin-bottom: 1.5rem;
        font-weight: 600;
      }
      .article-meta .category {
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .article-meta .author {
        color: var(--foreground);
      }
      h1 {
        font-size: 2.75rem;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.04em;
        color: var(--foreground);
        margin-bottom: 1.5rem;
      }
      .excerpt {
        font-size: 1.25rem;
        line-height: 1.6;
        color: var(--muted-foreground);
        margin-bottom: 2rem;
        font-weight: 500;
        border-left: 4px solid var(--border);
        padding-left: 1.5rem;
      }
      .content {
        font-size: 1.125rem;
        line-height: 1.8;
        color: var(--foreground);
      }
      .content :global(p) {
        margin-bottom: 1.75rem;
      }
      .content :global(h2) {
        font-size: 1.75rem;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .back-link {
        display: inline-flex;
        align-items: center;
        margin-bottom: 2rem;
        color: var(--primary);
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.2s;
      }
      .back-link:hover { opacity: 0.8; }
      
      /* Latest News Section */
      .latest-news-section {
        margin-top: 6rem;
        padding-top: 4rem;
        border-top: 1px solid var(--border);
      }
      .section-title {
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 2.5rem;
        letter-spacing: -0.04em;
        text-transform: uppercase;
        color: var(--foreground);
      }
      .latest-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2.5rem;
      }
      .latest-card {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.5rem;
        transition: opacity 0.2s;
      }
      .latest-card:hover { opacity: 0.8; }
      .latest-card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 1rem;
      }
      .latest-card h3 {
        font-size: 1.15rem;
        font-weight: 800;
        line-height: 1.3;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
      }
      .latest-card p {
        font-size: 0.9rem;
        color: var(--muted-foreground);
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .error-message {
        color: var(--destructive);
        padding: 1rem;
        border: 1px solid var(--destructive);
        border-radius: 8px;
        background: var(--muted);
      }

      @media (max-width: 720px) {
        h1 {
          font-size: 2rem;
        }
        .excerpt {
          font-size: 1.1rem;
        }
        .hero-image {
          margin-bottom: 1.5rem;
        }
        .prose {
          padding: 0 1rem 3rem;
        }
        .latest-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .latest-card img {
          display: none; /* Keep it extra clean on mobile as per organic feed style */
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <div class="prose">
        {error && <p class="error-message">⚠️ {error}</p>}

        {news && (
          <>
            <article>
              {imageUrl && (
                <div class="hero-image">
                  <img
                    src={imageUrl}
                    alt={news.featuredImage?.alt ?? news.title}
                    width={news.featuredImage?.width ?? 1200}
                    height={news.featuredImage?.height ?? 675}
                  />
                </div>
              )}

              <div class="article-meta">
                {news.category && <span class="category">{news.category.name}</span>}
                {news.author && <span class="author">{news.author.name}</span>}
              </div>

              <h1>{news.title}</h1>

              {description && (
                <div class="excerpt">
                  {description}
                </div>
              )}

              <div class="content" set:html={bodyHtml} />
            </article>

            {latestNews.length > 0 && (
              <section class="latest-news-section">
                <h2 class="section-title">Son Haberler</h2>
                <div class="latest-grid">
                  {latestNews.map((item) => {
                    const itemImg = item.featuredImage ? resolveMediaUrl(item.featuredImage.url) : null;
                    const itemDesc = item.seo?.metaDescription ?? lexicalToPlainText(item.body).slice(0, 100);
                    return (
                      <a href={`/haberler/${item.slug}`} class="latest-card">
                        {itemImg && <img src={itemImg} alt={item.title} />}
                        <h3>{item.title}</h3>
                        <p>{itemDesc}</p>
                      </a>
                    );
                  })}
                </div>
              </section>
            )}
          </>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>
