---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { fetchBlogList, resolveMediaUrl, lexicalToPlainText } from '../../lib/payload';
import type { BlogItem } from '../../lib/payload';

let posts: BlogItem[] = [];
let error: string | null = null;

try {
  const data = await fetchBlogList(1, 20);
  posts = data.docs;
} catch (e) {
  error = e instanceof Error ? e.message : 'Yazılar yüklenemedi.';
}

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('tr-TR', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description="Uzmanlardan ekonomi analizleri ve yorumlar." />
    <style>
      .page-header {
        border-bottom: 2px solid var(--accent);
        padding-bottom: 0.5rem;
        margin-bottom: 2rem;
        display: inline-block;
      }
      .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
      }
      .blog-card {
        border: 1px solid rgb(var(--gray-light));
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        transition: box-shadow 0.2s;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
      }
      .blog-card:hover { box-shadow: var(--box-shadow); }
      .blog-card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
      }
      .blog-card .no-img {
        width: 100%;
        aspect-ratio: 16 / 9;
        background: rgb(var(--gray-light));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
      }
      .blog-card-body {
        padding: 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      .blog-card-category {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--accent);
        margin-bottom: 0.4rem;
      }
      .blog-card h2 {
        font-size: 1.1rem;
        margin: 0 0 0.5rem;
        line-height: 1.4;
        color: rgb(var(--black));
        flex: 1;
      }
      .blog-card-desc {
        font-size: 0.875rem;
        color: rgb(var(--gray));
        margin: 0 0 0.75rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .blog-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.78rem;
        color: rgb(var(--gray));
        margin-top: auto;
      }
      .blog-card-footer .author { font-weight: 600; }
      .error-message {
        color: #c00; padding: 1rem;
        border: 1px solid #fcc; border-radius: 8px; background: #fff5f5;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1 class="page-header">Blog</h1>

      {error && <p class="error-message">⚠️ {error}</p>}
      {posts.length === 0 && !error && <p>Henüz yazı bulunmuyor.</p>}

      <div class="blog-grid">
        {posts.map((post) => {
          const imgUrl = post.featuredImage ? resolveMediaUrl(post.featuredImage.url) : null;
          const desc = post.seo?.metaDescription ?? lexicalToPlainText(post.body).slice(0, 140);
          return (
            <a href={`/blog/${post.slug}`} class="blog-card">
              {imgUrl
                ? <img src={imgUrl} alt={post.featuredImage?.alt ?? post.title} width={600} height={338} />
                : <div class="no-img">📝</div>
              }
              <div class="blog-card-body">
                {post.category && <p class="blog-card-category">{post.category.name}</p>}
                <h2>{post.title}</h2>
                {desc && <p class="blog-card-desc">{desc}</p>}
                <div class="blog-card-footer">
                  {post.author && <span class="author">{post.author.name}</span>}
                  {post.publishedAt && <span>{formatDate(post.publishedAt)}</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </main>
    <Footer />
  </body>
</html>
