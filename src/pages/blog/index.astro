---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { fetchBlogList, resolveMediaUrl, lexicalToPlainText } from '../../lib/payload';
import type { BlogItem } from '../../lib/payload';

let posts: BlogItem[] = [];
let error: string | null = null;

try {
  const data = await fetchBlogList(1, 20);
  posts = data.docs;
} catch (e) {
  error = e instanceof Error ? e.message : 'Yazılar yüklenemedi.';
}

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('tr-TR', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={`Blog — ${SITE_TITLE}`} description="Uzmanlardan ekonomi analizleri ve yorumlar." />
    <style>
      .page-header {
        border-bottom: 4px solid var(--primary);
        padding-bottom: 0.75rem;
        margin-bottom: 3rem;
        display: inline-block;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        text-transform: uppercase;
      }
      .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
      }
      .blog-card {
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        background: var(--card);
        transition: all 0.3s ease;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }
      .blog-card:hover { 
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08);
        border-color: var(--primary);
      }
      .blog-card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
      }
      .blog-card .no-img {
        width: 100%;
        aspect-ratio: 16 / 9;
        background: var(--muted);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
      }
      .blog-card-body {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      .blog-card-category {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--primary);
        margin-bottom: 0.5rem;
      }
      .blog-card h2 {
        font-size: 1.25rem;
        margin: 0 0 0.75rem;
        line-height: 1.4;
        color: var(--foreground);
        font-weight: 700;
        letter-spacing: -0.02em;
        flex: 1;
      }
      .blog-card-desc {
        font-size: 0.95rem;
        color: var(--muted-foreground);
        margin: 0 0 1.25rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .blog-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.85rem;
        color: var(--muted-foreground);
        margin-top: auto;
      }
      .author-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      .author-avatar, .author-avatar-placeholder {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        object-fit: cover;
      }
      .author-avatar-placeholder {
        background: var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
      }
      .author-name { 
        font-weight: 700;
        color: var(--foreground);
      }
      .date {
        font-weight: 500;
      }
      .error-message {
        color: var(--destructive); 
        padding: 1rem;
        border: 1px solid var(--destructive); 
        border-radius: 8px; 
        background: var(--muted);
      }
      @media (max-width: 768px) {
        .blog-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .blog-card {
          border: none !important;
          background: transparent !important;
          padding: 0 0 2rem 0 !important;
          border-bottom: 1px solid var(--border) !important;
          border-radius: 0 !important;
          box-shadow: none !important;
        }
        .blog-card:last-child {
          border-bottom: none !important;
        }
        .blog-card:not(:first-child) img {
          display: none;
        }
        .blog-card-body {
          padding: 0 !important;
          margin-top: 1rem;
        }
        .blog-card:not(:first-child) .blog-card-body {
          margin-top: 0;
        }
        .blog-card h2 {
          font-size: 1.25rem;
          margin-bottom: 0.5rem;
        }
        .blog-grid .blog-card:first-child h2 {
          font-size: 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1 class="page-header">Blog</h1>

      {error && <p class="error-message">⚠️ {error}</p>}
      {posts.length === 0 && !error && <p>Henüz yazı bulunmuyor.</p>}

      <div class="blog-grid">
        {posts.map((post) => {
          const imgUrl = post.featuredImage ? resolveMediaUrl(post.featuredImage.url) : null;
          const desc = post.seo?.metaDescription ?? lexicalToPlainText(post.body).slice(0, 140);
          return (
            <a href={`/blog/${post.slug}`} class="blog-card">
              {imgUrl
                ? <img src={imgUrl} alt={post.featuredImage?.alt ?? post.title} width={600} height={338} />
                : <div class="no-img">📝</div>
              }
              <div class="blog-card-body">
                {post.category && <p class="blog-card-category">{post.category.name}</p>}
                <h2>{post.title}</h2>
                {desc && <p class="blog-card-desc">{desc}</p>}
                <div class="blog-card-footer">
                  {post.author && (
                    <div class="author-info">
                      {post.author.profilePhoto ? (
                        <img src={resolveMediaUrl(post.author.profilePhoto.url)} alt={post.author.name} width={24} height={24} class="author-avatar" />
                      ) : (
                        <div class="author-avatar-placeholder">✍️</div>
                      )}
                      <span class="author-name">{post.author.name}</span>
                    </div>
                  )}
                  {post.publishedAt && <span class="date">{formatDate(post.publishedAt)}</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </main>
    <Footer />
  </body>
</html>
