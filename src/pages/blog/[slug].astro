---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import {
  fetchBlogBySlug,
  fetchBlogList,
  resolveMediaUrl,
  lexicalToPlainText,
  lexicalToHtml,
} from '../../lib/payload';
import type { BlogItem } from '../../lib/payload';

// SSR — canlı veri, her istekte Payload'dan çekilir
const { slug } = Astro.params;

let post: BlogItem | null = null;
let related: BlogItem[] = [];
let error: string | null = null;

try {
  post = await fetchBlogBySlug(slug!);
  if (!post) {
    error = 'Yazı bulunamadı.';
  } else {
    // Son 5 yazıyı sidebar için çek
    const listData = await fetchBlogList(1, 6);
    related = listData.docs.filter((p) => p.slug !== slug).slice(0, 5);
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Yazı yüklenemedi.';
}

const imageUrl = post?.featuredImage ? resolveMediaUrl(post.featuredImage.url) : null;
const authorPhotoUrl = post?.author?.profilePhoto
  ? resolveMediaUrl(post.author.profilePhoto.url)
  : null;

// Social media card: use author photo for blog posts (brand identity)
const ogImage = authorPhotoUrl ?? imageUrl ?? undefined;
const description =
  post?.seo?.metaDescription ?? lexicalToPlainText(post?.body).slice(0, 160);
const bodyHtml = post ? lexicalToHtml(post.body) : '';

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('tr-TR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={post?.seo?.metaTitle ?? post?.title ?? 'Blog'} description={description} image={ogImage} />
    <style>
      .page-layout {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0;
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 4rem;
        align-items: start;
      }
      @media (max-width: 1000px) {
        .page-layout {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
      }

      /* ── Article ── */
      .article-hero {
        width: 100vw;
        margin-left: calc(-50vw + 50%);
        margin-right: calc(-50vw + 50%);
        margin-bottom: 2.5rem;
        overflow: hidden;
      }
      .article-hero img {
        width: 100%;
        max-height: 600px;
        object-fit: cover;
        display: block;
      }
      article {
        width: 720px;
        max-width: 100%;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }
      .article-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--muted-foreground);
      }
      .article-meta .category {
        color: var(--primary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .article-title {
        font-size: 2.75rem;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.04em;
        color: var(--foreground);
        margin: 0 0 1.5rem;
      }

      /* Author box */
      .author-box {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem;
        background: var(--muted);
        border-radius: 12px;
        margin-bottom: 3rem;
        border: 1px solid var(--border);
      }
      .author-box img, .author-avatar-placeholder {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
      }
      .author-avatar-placeholder {
        background: var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
      }
      .author-info .name {
        font-weight: 800;
        font-size: 1rem;
        color: var(--foreground);
        margin: 0 0 0.25rem;
      }
      .author-info .bio {
        font-size: 0.85rem;
        color: var(--muted-foreground);
        margin: 0;
        line-height: 1.4;
      }

      /* Article body */
      .article-body {
        color: var(--foreground);
        line-height: 1.8;
        font-size: 1.125rem;
      }
      .article-body :global(p) { margin-bottom: 1.75rem; }
      .article-body :global(h2) { 
        font-size: 1.75rem; 
        margin: 3rem 0 1.25rem; 
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .article-body :global(h3) { 
        font-size: 1.4rem; 
        margin: 2rem 0 1rem; 
        font-weight: 700;
      }
      .article-body :global(blockquote) {
        border-left: 4px solid var(--primary);
        padding: 0.5rem 0 0.5rem 1.5rem;
        margin: 2.5rem 0;
        font-size: 1.25rem;
        color: var(--muted-foreground);
        font-weight: 500;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        margin-bottom: 2rem;
        color: var(--primary);
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
      }

      /* Sidebar */
      .sidebar {
        position: sticky;
        top: 6rem;
        padding: 2rem 0;
      }
      .sidebar-title {
        font-size: 0.85rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted-foreground);
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--border);
      }
      .sidebar-post {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        text-decoration: none;
        color: inherit;
      }
      .sidebar-post img, .sidebar-post-thumb-placeholder {
        width: 64px;
        height: 48px;
        object-fit: cover;
        border-radius: 8px;
        flex-shrink: 0;
      }
      .sidebar-post-title {
        font-size: 0.9rem;
        font-weight: 700;
        line-height: 1.4;
        color: var(--foreground);
      }
      .sidebar-post-date {
        font-size: 0.8rem;
        color: var(--muted-foreground);
        margin-top: 0.25rem;
      }

      @media (max-width: 720px) {
        .article-title {
          font-size: 2rem;
        }
        article {
          padding: 1.5rem 1rem 3rem;
        }
        .article-hero {
          margin-bottom: 1.5rem;
        }
        .sidebar {
          padding: 2rem 1rem;
          border-top: 1px solid var(--border);
        }
      }
    </style>
  </head>
  <body>
    <Header />

    <div class="page-layout">
      <!-- Main article -->
      <article>
        <a href="/blog" class="back-link">← Tüm Yazılar</a>

        {error && <p class="error-message">⚠️ {error}</p>}

        {post && (
          <>
            {imageUrl && (
              <div class="article-hero">
                <img
                  src={imageUrl}
                  alt={post.featuredImage?.alt ?? post.title}
                  width={post.featuredImage?.width ?? 1200}
                  height={post.featuredImage?.height ?? 675}
                />
              </div>
            )}

            <div class="article-meta">
              {post.category && <span class="category">{post.category.name}</span>}
              {post.publishedAt && (
                <span class="date">{formatDate(post.publishedAt)}</span>
              )}
            </div>

            <h1 class="article-title">{post.title}</h1>

            {post.author && (
              <div class="author-box">
                {authorPhotoUrl
                  ? <img src={authorPhotoUrl} alt={post.author.name} width={48} height={48} />
                  : <div class="author-avatar-placeholder">✍️</div>
                }
                <div class="author-info">
                  <p class="name">{post.author.name}</p>
                  {post.author.shortBio && (
                    <p class="bio">{post.author.shortBio}</p>
                  )}
                </div>
              </div>
            )}

            <div class="article-body" set:html={bodyHtml} />
          </>
        )}
      </article>

      <!-- Sidebar -->
      <aside class="sidebar">
        <h2 class="sidebar-title">Son Yazılar</h2>
        {related.map((p) => {
          const thumb = p.featuredImage ? resolveMediaUrl(p.featuredImage.url) : null;
          return (
            <a href={`/blog/${p.slug}`} class="sidebar-post">
              {thumb
                ? <img src={thumb} alt={p.featuredImage?.alt ?? p.title} width={72} height={54} />
                : <div class="sidebar-post-thumb-placeholder">📝</div>
              }
              <div>
                <p class="sidebar-post-title">{p.title}</p>
                {p.publishedAt && (
                  <p class="sidebar-post-date">{formatDate(p.publishedAt)}</p>
                )}
              </div>
            </a>
          );
        })}
      </aside>
    </div>

    <Footer />
  </body>
</html>
