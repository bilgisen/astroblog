---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import {
  fetchBlogBySlug,
  fetchBlogList,
  resolveMediaUrl,
  lexicalToPlainText,
  lexicalToHtml,
} from '../../lib/payload';
import type { BlogItem } from '../../lib/payload';

// SSR — canlı veri, her istekte Payload'dan çekilir
const { slug } = Astro.params;

let post: BlogItem | null = null;
let related: BlogItem[] = [];
let error: string | null = null;

try {
  post = await fetchBlogBySlug(slug!);
  if (!post) {
    error = 'Yazı bulunamadı.';
  } else {
    // Son 5 yazıyı sidebar için çek
    const listData = await fetchBlogList(1, 6);
    related = listData.docs.filter((p) => p.slug !== slug).slice(0, 5);
  }
} catch (e) {
  error = e instanceof Error ? e.message : 'Yazı yüklenemedi.';
}

const imageUrl = post?.featuredImage ? resolveMediaUrl(post.featuredImage.url) : null;
const authorPhotoUrl = post?.author?.profilePhoto
  ? resolveMediaUrl(post.author.profilePhoto.url)
  : null;

// SM image: use post's featuredImage (which is the author image in this setup)
// fallback to author profilePhoto
const ogImage = imageUrl ?? authorPhotoUrl ?? undefined;

// Social meta title: "Author yazdı — Post title"
const ogTitle = post
  ? (post.author ? `${post.author.name} yazdı — ${post.title}` : post.title)
  : 'Blog';
const description =
  post?.seo?.metaDescription ?? lexicalToPlainText(post?.body).slice(0, 160);
const bodyHtml = post ? lexicalToHtml(post.body) : '';

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('tr-TR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
}
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={ogTitle} description={description} image={ogImage} />
    <style>
      .page-layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 3rem;
        align-items: start;
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }

      /* ── Article ── */
      .article-hero img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
        display: block;
        margin-bottom: 1.5rem;
      }
      .article-meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
      }
      .article-meta .category {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--accent);
        background: rgba(35, 55, 255, 0.08);
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
      }
      .article-meta .date {
        font-size: 0.8rem;
        color: rgb(var(--gray));
      }
      .article-title {
        font-size: 2rem;
        line-height: 1.3;
        margin: 0 0 1.5rem;
        color: rgb(var(--black));
      }

      /* Author box */
      .author-box {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        background: rgb(var(--gray-light), 0.3);
        border-radius: 10px;
        margin-bottom: 2rem;
        border: 1px solid rgb(var(--gray-light));
      }
      .author-box img {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
      }
      .author-box .author-avatar-placeholder {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgb(var(--gray-light));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
      }
      .author-box .author-info .name {
        font-weight: 700;
        font-size: 0.9rem;
        color: rgb(var(--black));
      }
      .author-box .author-info .bio {
        font-size: 0.8rem;
        color: rgb(var(--gray));
        margin: 0;
      }

      /* Article body */
      .article-body {
        color: rgb(var(--gray-dark));
        line-height: 1.8;
        font-size: 1.05rem;
      }
      .article-body h2 { font-size: 1.5rem; margin: 2rem 0 0.75rem; }
      .article-body h3 { font-size: 1.25rem; margin: 1.5rem 0 0.5rem; }
      .article-body p  { margin-bottom: 1.25rem; }
      .article-body a  { color: var(--accent); }
      .article-body blockquote {
        border-left: 4px solid var(--accent);
        padding: 0.5rem 0 0.5rem 1.25rem;
        margin: 1.5rem 0;
        font-style: italic;
        color: rgb(var(--gray));
      }
      .article-body ul { padding-left: 1.5rem; margin-bottom: 1.25rem; }
      .article-body li { margin-bottom: 0.4rem; }
      .article-body code {
        background: rgb(var(--gray-light));
        padding: 0.1em 0.4em;
        border-radius: 3px;
        font-size: 0.9em;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 1.5rem;
        color: var(--accent);
        font-size: 0.875rem;
        text-decoration: none;
      }
      .back-link:hover { text-decoration: underline; }

      /* ── Sidebar ── */
      .sidebar {
        position: sticky;
        top: 1.5rem;
      }
      .sidebar-title {
        font-size: 1rem;
        font-weight: 700;
        color: rgb(var(--black));
        margin: 0 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--accent);
      }
      .sidebar-post {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1rem;
        text-decoration: none;
        color: inherit;
        align-items: flex-start;
      }
      .sidebar-post:hover .sidebar-post-title {
        color: var(--accent);
      }
      .sidebar-post img {
        width: 72px;
        height: 54px;
        object-fit: cover;
        border-radius: 6px;
        flex-shrink: 0;
      }
      .sidebar-post .sidebar-post-thumb-placeholder {
        width: 72px;
        height: 54px;
        background: rgb(var(--gray-light));
        border-radius: 6px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
      }
      .sidebar-post-title {
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.4;
        color: rgb(var(--black));
        transition: color 0.2s;
      }
      .sidebar-post-date {
        font-size: 0.75rem;
        color: rgb(var(--gray));
        margin-top: 0.25rem;
      }

      .error-message {
        color: #c00;
        padding: 1rem;
        border: 1px solid #fcc;
        border-radius: 8px;
        background: #fff5f5;
      }

      @media (max-width: 900px) {
        .page-layout {
          grid-template-columns: 1fr;
        }
        .sidebar {
          position: static;
          border-top: 1px solid rgb(var(--gray-light));
          padding-top: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <Header />

    <div class="page-layout">
      <!-- Main article -->
      <article>
        <a href="/blog" class="back-link">← Tüm Yazılar</a>

        {error && <p class="error-message">⚠️ {error}</p>}

        {post && (
          <>
            {imageUrl && (
              <div class="article-hero">
                <img
                  src={imageUrl}
                  alt={post.featuredImage?.alt ?? post.title}
                  width={post.featuredImage?.width ?? 1200}
                  height={post.featuredImage?.height ?? 675}
                />
              </div>
            )}

            <div class="article-meta">
              {post.category && <span class="category">{post.category.name}</span>}
              {post.publishedAt && (
                <span class="date">{formatDate(post.publishedAt)}</span>
              )}
            </div>

            <h1 class="article-title">{post.title}</h1>

            {post.author && (
              <div class="author-box">
                {authorPhotoUrl
                  ? <img src={authorPhotoUrl} alt={post.author.name} width={48} height={48} />
                  : <div class="author-avatar-placeholder">✍️</div>
                }
                <div class="author-info">
                  <p class="name">{post.author.name}</p>
                  {post.author.shortBio && (
                    <p class="bio">{post.author.shortBio}</p>
                  )}
                </div>
              </div>
            )}

            <div class="article-body" set:html={bodyHtml} />
          </>
        )}
      </article>

      <!-- Sidebar -->
      <aside class="sidebar">
        <h2 class="sidebar-title">Son Yazılar</h2>
        {related.map((p) => {
          const thumb = p.featuredImage ? resolveMediaUrl(p.featuredImage.url) : null;
          return (
            <a href={`/blog/${p.slug}`} class="sidebar-post">
              {thumb
                ? <img src={thumb} alt={p.featuredImage?.alt ?? p.title} width={72} height={54} />
                : <div class="sidebar-post-thumb-placeholder">📝</div>
              }
              <div>
                <p class="sidebar-post-title">{p.title}</p>
                {p.publishedAt && (
                  <p class="sidebar-post-date">{formatDate(p.publishedAt)}</p>
                )}
              </div>
            </a>
          );
        })}
      </aside>
    </div>

    <Footer />
  </body>
</html>
