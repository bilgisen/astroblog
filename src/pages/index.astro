---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { fetchNewsList, fetchBlogList, resolveMediaUrl, lexicalToPlainText } from '../lib/payload';
import type { NewsItem, BlogItem } from '../lib/payload';
import { Button } from '@/components/ui/button';

let news: NewsItem[] = [];
let blogs: BlogItem[] = [];
let error: string | null = null;

try {
  const [newsData, blogData] = await Promise.all([
    fetchNewsList(1, 50),
    fetchBlogList(1, 6),
  ]);
  news = newsData.docs;
  blogs = blogData.docs;
} catch (e) {
  error = e instanceof Error ? e.message : 'İçerik yüklenemedi.';
}

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('tr-TR', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      /* ── Sponsor Banner ── */
      .sponsor-banner {
        display: block;
        text-align: center;
        margin-bottom: 1.5rem;
        border-radius: 8px;
        overflow: hidden;
        line-height: 0;
      }
      .sponsor-banner img {
        max-width: 970px;
        width: 100%;
        height: auto;
        border-radius: 8px;
        display: inline-block;
      }

      #load-more-btn.hidden {
        display: none;
      }

      /* ── Section title ── */
      .section-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--foreground);
        margin: 0 0 2.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 4px solid var(--primary);
        display: inline-block;
        letter-spacing: -0.04em;
        text-transform: uppercase;
      }

      /* ── Featured (big) card ── */
      .featured-card {
        display: flex;
        flex-direction: column;
        margin-bottom: 3rem;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        background: var(--card);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        color: inherit;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }
      .featured-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08);
        border-color: var(--primary);
      }
      .featured-card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
      }
      .featured-card:hover img {
        transform: scale(1.02);
      }
      .featured-card .card-body {
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
      }
      .featured-card .card-body .category {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--primary);
        margin-bottom: 1rem;
      }
      .featured-card .card-body h2 {
        font-size: 2.25rem;
        margin: 0 0 1rem;
        line-height: 1.1;
        color: var(--foreground);
        font-weight: 800;
        letter-spacing: -0.04em;
      }
      .featured-card .card-body .desc {
        font-size: 1.125rem;
        color: var(--muted-foreground);
        margin: 0 0 1.5rem;
        line-height: 1.6;
        font-weight: 500;
      }

      /* ── Small card grid ── */
      .small-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        margin-bottom: 4rem;
      }
      .small-card {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.5rem;
      }
      .small-card:hover {
        opacity: 0.8;
      }
      .small-card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
        border-radius: 8px;
        margin-bottom: 1.25rem;
      }
      .small-card .card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      .small-card .category {
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--primary);
        margin-bottom: 0.5rem;
        letter-spacing: 0.05em;
      }
      .small-card h3 {
        font-size: 1.25rem;
        margin: 0 0 0.75rem;
        line-height: 1.3;
        color: var(--foreground);
        font-weight: 800;
        letter-spacing: -0.03em;
      }
      .small-card .desc {
        font-size: 0.95rem;
        color: var(--muted-foreground);
        margin: 0;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* ── Load More Grid ── */
      .load-more-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        margin-bottom: 3rem;
      }

      /* ── Organic Feed (Mobile) ── */
      @media (max-width: 768px) {
        .small-grid, .load-more-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .small-card {
          border: none !important;
          background: transparent !important;
          padding: 0 0 3rem 0 !important;
          border-bottom: 1px solid var(--border) !important;
          border-radius: 0 !important;
          box-shadow: none !important;
        }
        .small-card:last-child {
          border-bottom: none !important;
        }
        .small-card img {
          display: block !important;
          border-radius: 12px;
          margin-bottom: 1.25rem;
        }
        .small-card-body {
          padding: 0 !important;
        }
        .small-card h3 {
          font-size: 1.5rem !important;
          line-height: 1.2;
          margin-bottom: 0.75rem;
        }
      }

      #load-more-btn.hidden {
        display: none;
      }

      /* ── No image placeholder ── */
      .no-img {
        background: var(--muted);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted-foreground);
        font-size: 2rem;
      }

      /* ── Page layout: main + sidebar ── */
      .page-layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 2.5rem;
        align-items: start;
      }

      /* Ana sayfa için main genişliğini artır */
      :global(main) {
        width: 1200px !important;
        max-width: calc(100% - 2em) !important;
      }
      .sidebar {
        position: sticky;
        top: 6rem;
      }
      .sidebar-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--foreground);
        margin: 0 0 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary);
        letter-spacing: -0.02em;
      }
      .sidebar-post {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
        text-decoration: none;
        color: inherit;
        align-items: flex-start;
      }
      .sidebar-post:hover .sidebar-post-title { color: var(--primary); }
      .sidebar-post img {
        width: 80px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        flex-shrink: 0;
      }
      .sidebar-post-thumb-placeholder {
        width: 80px;
        height: 60px;
        background: var(--muted);
        border-radius: 8px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
      }
      .sidebar-post-title {
        font-size: 0.9rem;
        font-weight: 600;
        line-height: 1.4;
        color: var(--foreground);
        transition: color 0.2s;
        margin: 0 0 0.2rem;
      }
      .sidebar-post-date {
        font-size: 0.75rem;
        color: var(--muted-foreground);
      }
      .sidebar-more {
        display: block;
        text-align: center;
        margin-top: 0.5rem;
        font-size: 0.85rem;
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
      }
      .sidebar-more:hover { text-decoration: underline; }

      @media (max-width: 1100px) {
        .page-layout { grid-template-columns: 1fr 260px; }
      }
      @media (max-width: 960px) {
        .page-layout { grid-template-columns: 1fr; }
        .sidebar { position: static; border-top: 1px solid rgb(var(--gray-light)); padding-top: 2rem; }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <!-- Sponsor Banner -->
      <a href="https://6c4d.adj.st/?adj_t=1n5vmtep&adj_fallback=https%3A%2F%2Fsozlesme.gedik.com%3Futm_source%3Dparaanaliz%26utm_medium%3Dbanner%26utm_campaign%3Dvirman-kampanyasi&adj_redirect_macos=https%3A%2F%2Fsozlesme.gedik.com%3Futm_source%3Dparaanaliz%26utm_medium%3Dbanner%26utm_campaign%3Dvirman-kampanyasi" target="_blank" rel="noopener noreferrer" class="sponsor-banner">
        <img
          src={resolveMediaUrl('/api/media/file/gedik.jpg')}
          alt="Gedik Yatırım"
          width="970"
          height="90"
        />
      </a>

      <div class="page-layout">
        <!-- Sol: Haberler -->
        <div>
          <h2 class="section-title">Günün Gündemi</h2>

          {error && (
            <p style="color:#c00;padding:1rem;border:1px solid #fcc;border-radius:8px;background:#fff5f5;">
              ⚠️ {error}
            </p>
          )}

          {news.length === 0 && !error && <p>Henüz haber bulunmuyor.</p>}

          {news.length > 0 && (() => {
            const big1   = news[0];
            const pair1  = news.slice(1, 3);
            const big2   = news[3] ?? null;
            const rest   = news.slice(4);

            function featuredCard(item: NewsItem) {
              const imgUrl = item.featuredImage ? resolveMediaUrl(item.featuredImage.url) : null;
              const desc = item.seo?.metaDescription ?? lexicalToPlainText(item.body).slice(0, 160);
              return (
                <a href={`/haberler/${item.slug}`} class="featured-card">
                  {imgUrl
                    ? <img src={imgUrl} alt={item.featuredImage?.alt ?? item.title} width={1200} height={675} />
                    : <div class="no-img">📰</div>
                  }
                  <div class="card-body">
                    {item.category && <p class="category">{item.category.name}</p>}
                    <h2>{item.title}</h2>
                    {desc && <p class="desc">{desc}</p>}
                  </div>
                </a>
              );
            }

            function smallCard(item: NewsItem) {
              const imgUrl = item.featuredImage ? resolveMediaUrl(item.featuredImage.url) : null;
              const desc = item.seo?.metaDescription ?? lexicalToPlainText(item.body).slice(0, 120);
              return (
                <a href={`/haberler/${item.slug}`} class="small-card">
                  {imgUrl
                    ? <img src={imgUrl} alt={item.featuredImage?.alt ?? item.title} width={400} height={160} />
                    : <div class="no-img">📰</div>
                  }
                  <div class="card-body">
                    {item.category && <p class="category">{item.category.name}</p>}
                    <h3>{item.title}</h3>
                    {desc && <p class="desc">{desc}</p>}
                  </div>
                </a>
              );
            }

            return (
              <>
                {featuredCard(big1)}
                {pair1.length > 0 && (
                  <div class="small-grid">{pair1.map(smallCard)}</div>
                )}
                {big2 && featuredCard(big2)}
                {rest.length > 0 && (
                  <>
                    <div class="load-more-grid" id="load-more-grid">
                      {rest.map((item) => (
                        <div class="load-more-item" style="display:none">
                          {smallCard(item)}
                        </div>
                      ))}
                    </div>
                    <Button id="load-more-btn" className="mx-auto block mt-8">Daha Fazla Göster</Button>
                  </>
                )}
              </>
            );
          })()}
        </div>

        <!-- Sağ: Blog sidebar -->
        <aside class="sidebar">
          <h2 class="sidebar-title">Son Blog Yazıları</h2>
          {blogs.map((post) => {
            const thumb = post.featuredImage ? resolveMediaUrl(post.featuredImage.url) : null;
            return (
              <a href={`/blog/${post.slug}`} class="sidebar-post">
                {thumb
                  ? <img src={thumb} alt={post.featuredImage?.alt ?? post.title} width={72} height={54} />
                  : <div class="sidebar-post-thumb-placeholder">📝</div>
                }
                <div>
                  <p class="sidebar-post-title">{post.title}</p>
                  {post.publishedAt && (
                    <p class="sidebar-post-date">{formatDate(post.publishedAt)}</p>
                  )}
                </div>
              </a>
            );
          })}
          {blogs.length === 0 && <p style="font-size:0.85rem;color:rgb(var(--gray))">Henüz yazı yok.</p>}
          <a href="/blog" class="sidebar-more">Tüm yazılar →</a>
        </aside>
      </div>
    </main>
    <Footer />

    <script>
      const btn = document.getElementById('load-more-btn');
      const items = document.querySelectorAll('#load-more-grid .load-more-item');
      let shown = 0;
      const batch = 4;

      function showNext() {
        const end = Math.min(shown + batch, items.length);
        for (let i = shown; i < end; i++) {
          (items[i] as HTMLElement).style.display = 'block';
        }
        shown = end;
        if (shown >= items.length && btn) {
          btn.classList.add('hidden');
        }
      }

      if (btn) {
        btn.addEventListener('click', showNext);
      }
    </script>
  </body>
</html>
