---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MainSlider from '../components/MainSlider.astro';
import GoogleNewsBanner from '../components/GoogleNewsBanner.astro';
import VideoWidget from '../components/VideoWidget';
import { fetchParaAnalizVideos } from '../lib/youtube';
import type { VideoItem } from '../lib/youtube';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { fetchNewsList, fetchBlogList, resolveMediaUrl, lexicalToPlainText, fetchFromPayload } from '../lib/payload';
import type { NewsItem, BlogItem, NewsListResponse } from '../lib/payload';
import { Button } from '@/components/ui/button';

let news: NewsItem[] = [];
let sliderSlides: NewsItem[] = [];
let blogs: BlogItem[] = [];
let ytVideos: VideoItem[] = [];
let error: string | null = null;

try {
  // Fetch latest news, blog posts, and ParaAnaliz YouTube videos concurrently
  const [newsData, blogData, videos] = await Promise.all([
    fetchNewsList(1, 60, [28]),
    fetchBlogList(1, 20),
    fetchParaAnalizVideos(),
  ]);
  
  ytVideos = videos;
  const latestNewsDocs = newsData.docs;
  
  // Filter for unique authors to show only their latest blog post
  const uniqueAuthors = new Map<number, BlogItem>();
  blogData.docs.forEach(post => {
    if (post.author && !uniqueAuthors.has(post.author.id)) {
      uniqueAuthors.set(post.author.id, post);
    }
  });
  blogs = Array.from(uniqueAuthors.values()).slice(0, 6);

  // Fetch slide-tagged news items for exact slot positioning
  let taggedNewsDocs: NewsItem[] = [];
  try {
    const slideSlugs = Array.from({ length: 10 }, (_, i) => `slide-${String(i + 1).padStart(2, '0')}`);
    let endpoint = `/api/news?limit=30&where[category][not_in][]=28`;
    slideSlugs.forEach(slug => {
      endpoint += `&where[tags.slug][in][]=${slug}`;
    });

    const taggedRes = await fetchFromPayload(endpoint) as NewsListResponse;
    taggedNewsDocs = taggedRes.docs;
    // console.log(`Fetched ${taggedNewsDocs.length} tagged news items`);
  } catch (err) {
    console.error("Error fetching tagged slider items:", err);
  }

  // Combine and sort candidates by publish date descending
  const allCandidatesMap = new Map<number, NewsItem>();
  
  // Robust client-side filtering as a fallback to API-level exclusion
  const filterAds = (item: NewsItem) => item.category && item.category.id !== 28;

  latestNewsDocs.filter(filterAds).forEach(item => allCandidatesMap.set(item.id, item));
  taggedNewsDocs.filter(filterAds).forEach(item => allCandidatesMap.set(item.id, item));

  const sortedCandidates = Array.from(allCandidatesMap.values()).sort((a, b) => {
    const dateA = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
    const dateB = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
    return dateB - dateA;
  });

  // Pin tagged news items to specific slots
  const slides: (NewsItem | null)[] = Array(10).fill(null);
  const placedIds = new Set<number>();

  sortedCandidates.forEach(item => {
    if (item.tags && item.tags.length > 0) {
      const slideTag = item.tags.find(t => /^slide-\d+$/.test(t.slug));
      if (slideTag) {
        const pos = parseInt(slideTag.slug.replace('slide-', ''), 10);
        const index = pos - 1;
        if (index >= 0 && index < 10) {
          if (!slides[index]) {
            slides[index] = item;
            placedIds.add(item.id);
          }
        }
      }
    }
  });

  // Fill empty slots with untagged/unplaced latest news
  for (let i = 0; i < 10; i++) {
    if (!slides[i]) {
      // Find next available item that DOES NOT have any slide-XX tag
      const nextAvailable = sortedCandidates.find(item => {
        if (placedIds.has(item.id)) return false;
        const hasSlideTag = item.tags?.some(t => /^slide-\d+$/.test(t.slug));
        return !hasSlideTag;
      });
      if (nextAvailable) {
        slides[i] = nextAvailable;
        placedIds.add(nextAvailable.id);
      }
    }
  }

  sliderSlides = slides.filter((s): s is NewsItem => s !== null);

  // Remaining news items populate the home page feed (without duplication)
  news = sortedCandidates.filter(item => !placedIds.has(item.id));

} catch (e) {
  error = e instanceof Error ? e.message : 'İçerik yüklenemedi.';
}

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('tr-TR', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      /* ── Sponsor Banner ── */
      .sponsor-banner {
        display: block;
        text-align: center;
        margin-bottom: 1.5rem;
        border-radius: 8px;
        overflow: hidden;
        line-height: 0;
      }
      .sponsor-banner img {
        max-width: 970px;
        width: 100%;
        height: auto;
        border-radius: 8px;
        display: inline-block;
      }

      #load-more-btn.hidden {
        display: none;
      }

      /* ── Section title ── */
      .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--foreground);
        opacity: 0.9;
        margin: 0 0 2.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 4px solid var(--primary);
        display: inline-block;
        letter-spacing: -0.04em;
        text-transform: uppercase;
      }

      /* ── Featured (big) card ── */
      .featured-card {
        display: flex;
        flex-direction: column;
        margin-bottom: 3rem;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        background: var(--card);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        color: inherit;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }
      .featured-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.08);
        border-color: var(--primary);
      }
      .featured-card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
      }
      .featured-card:hover img {
        transform: scale(1.02);
      }
      .featured-card .card-body {
        padding: 2.5rem;
        display: flex;
        flex-direction: column;
      }
      .featured-card .card-body .category {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--primary);
        margin-bottom: 1rem;
      }
      .featured-card .card-body h2 {
        font-size: 2.25rem;
        margin: 0 0 1rem;
        line-height: 1.1;
        color: var(--foreground);
        opacity: 0.9;
        font-weight: 700;
        letter-spacing: -0.04em;
      }
      .featured-card .card-body .desc {
        font-size: 1.125rem;
        color: var(--muted-foreground);
        margin: 0 0 1.5rem;
        line-height: 1.6;
        font-weight: 400;
      }

      /* ── News Grid ── */
      .news-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        margin-bottom: 3rem;
      }
      .small-card {
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        transition: all 0.3s ease;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.5rem;
      }
      .small-card:hover {
        opacity: 0.8;
      }
      .small-card img {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
        border-radius: 8px;
        margin-bottom: 1.25rem;
      }
      .small-card .card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
      }
      .small-card .category {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--primary);
        margin-bottom: 0.5rem;
        letter-spacing: 0.05em;
      }
      .small-card h3 {
        font-size: 1.15rem;
        margin: 0 0 0.75rem;
        line-height: 1.3;
        color: var(--foreground);
        opacity: 0.9;
        font-weight: 700;
        letter-spacing: -0.03em;
      }
      .small-card .desc {
        font-size: 0.95rem;
        color: var(--muted-foreground);
        margin: 0;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* ── Organic Feed (Mobile) ── */
      @media (max-width: 768px) {
        .news-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .small-card {
          border: none !important;
          background: transparent !important;
          padding: 0 0 3rem 0 !important;
          border-bottom: 1px solid var(--border) !important;
          border-radius: 0 !important;
          box-shadow: none !important;
        }
        .small-card:last-child {
          border-bottom: none !important;
        }
        .small-card img {
          display: block !important;
          border-radius: 12px;
          margin-bottom: 1.25rem;
        }
        .small-card-body {
          padding: 0 !important;
        }
        .small-card h3 {
          font-size: 1.25rem !important;
          line-height: 1.2;
          margin-bottom: 0.75rem;
        }
      }

      #load-more-btn.hidden {
        display: none;
      }

      /* ── No image placeholder ── */
      .no-img {
        background: var(--muted);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted-foreground);
        font-size: 2rem;
      }

      /* ── Page layout: main + sidebar ── */
      .page-layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 2.5rem;
        align-items: start;
      }

      /* Ana sayfa için main genişliğini artır */
      :global(main) {
        width: 100% !important;
        max-width: 1200px !important;
        margin: 0 auto !important;
        padding: 0 1rem !important;
        box-sizing: border-box;
      }
      .sidebar {
        position: sticky;
        top: 6rem;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      }
      .sidebar-banner {
        display: block;
        margin: -1.5rem -1.5rem 1.5rem;
        border-radius: 16px 16px 0 0;
        overflow: hidden;
        border-bottom: 1px solid var(--border);
      }
      .sidebar-banner img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.3s ease;
      }
      .sidebar-banner:hover img {
        transform: scale(1.02);
      }
      .sidebar-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--foreground);
        opacity: 0.85;
        margin: 0 0 1.25rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border);
        letter-spacing: -0.02em;
        text-transform: uppercase;
      }
      .sidebar-post {
        display: flex;
        gap: 1rem;
        padding: 0.75rem;
        margin: 0 -0.75rem 0.25rem;
        text-decoration: none;
        color: inherit;
        align-items: center;
        border-radius: 12px;
        transition: all 0.2s ease;
      }
      .sidebar-post:hover {
        background: var(--muted);
      }
      .sidebar-post:hover .sidebar-post-title { color: var(--primary); }
      .sidebar-post-thumb-wrapper {
        width: 56px;
        height: 56px;
        flex-shrink: 0;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid var(--border);
      }
      .sidebar-post img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.3s ease;
      }
      .sidebar-post:hover img {
        transform: scale(1.05);
      }
      .sidebar-post-thumb-placeholder {
        width: 100%;
        height: 100%;
        background: var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
      }
      .sidebar-post-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        flex: 1;
      }
      .sidebar-post-author {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--primary);
        opacity: 0.9;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 0.25rem;
      }
      .sidebar-post-title {
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.35;
        color: var(--foreground);
        opacity: 0.85;
        transition: color 0.2s, opacity 0.2s;
        margin: 0 0 0.3rem;
        display: -webkit-box;
        -webkit-line-clamp: 4;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .sidebar-post:hover .sidebar-post-title {
        opacity: 1;
      }
      .sidebar-post-date {
        font-size: 0.75rem;
        color: var(--muted-foreground);
        font-weight: 500;
      }
      .sidebar-more {
        display: block;
        text-align: center;
        margin-top: 1rem;
        padding: 0.75rem;
        font-size: 0.85rem;
        color: var(--primary);
        text-decoration: none;
        font-weight: 700;
        border-radius: 8px;
        background: var(--muted);
        transition: background 0.2s ease;
      }
      .sidebar-more:hover {
        background: var(--border);
      }

      @media (max-width: 960px) {
        .page-layout { 
          grid-template-columns: 1fr; 
          display: flex;
          flex-direction: column;
        }
        .sidebar { 
          order: -1;
          margin-bottom: 2rem;
          position: static; 
          padding-top: 2rem; 
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <!-- Sponsor Banner -->
      <a href="https://6c4d.adj.st/?adj_t=1n5vmtep&adj_fallback=https%3A%2F%2Fsozlesme.gedik.com%3Futm_source%3Dparaanaliz%26utm_medium%3Dbanner%26utm_campaign%3Dvirman-kampanyasi&adj_redirect_macos=https%3A%2F%2Fsozlesme.gedik.com%3Futm_source%3Dparaanaliz%26utm_medium%3Dbanner%26utm_campaign%3Dvirman-kampanyasi" target="_blank" rel="noopener noreferrer" class="sponsor-banner">
        <img
          src={resolveMediaUrl('/api/media/file/gedik.jpg')}
          alt="Gedik Yatırım"
          width="970"
          height="90"
        />
      </a>

      <!-- Main Slider (Premium Embla Carousel) -->
      <MainSlider slides={sliderSlides} />

      <div class="page-layout">
        <!-- Sol: Haberler -->
        <div>
          <GoogleNewsBanner />
          <VideoWidget client:load initialVideos={ytVideos} />

          {error && (
            <p style="color:#c00;padding:1rem;border:1px solid #fcc;border-radius:8px;background:#fff5f5;">
              ⚠️ {error}
            </p>
          )}

          {news.length === 0 && !error && <p>Henüz haber bulunmuyor.</p>}

          {news.length > 0 && (
            <>
              <div class="news-grid" id="news-grid">
                {news.map((item, index) => {
                  const imgUrl = item.featuredImage ? resolveMediaUrl(item.featuredImage.url) : null;
                  const desc = item.seo?.metaDescription ?? lexicalToPlainText(item.body).slice(0, 120);
                  const isHidden = index >= 20;
                  return (
                    <div class="news-item" style={isHidden ? "display: none" : ""} data-index={index}>
                      <a href={`/haberler/${item.slug}`} class="small-card">
                        {imgUrl ? (
                          <img src={imgUrl} alt={item.featuredImage?.alt ?? item.title} width={400} height={160} />
                        ) : (
                          <div class="no-img">📰</div>
                        )}
                        <div class="card-body">
                          {item.category && <p class="category">{item.category.name}</p>}
                          <h3>{item.title}</h3>
                          {desc && <p class="desc">{desc}</p>}
                        </div>
                      </a>
                    </div>
                  );
                })}
              </div>

              {news.length > 20 && (
                <Button id="load-more-btn" className="mx-auto block mt-8">Daha Fazla Göster</Button>
              )}
            </>
          )}
        </div>

        <!-- Sağ: Blog sidebar -->
        <aside class="sidebar">
          <a href="https://sanatif.com.tr/urun/12-para-terapi-kampi-dr-cuneyt-akman-atilla-yesilada-baris-soydan-durmus-yilmaz-ve-dr-emre-akanak-23-26-agustos-2026-hattusa-kazdaglari/" target="_blank" rel="noopener noreferrer" class="sidebar-banner">
            <img src="https://sanatif.com.tr/wp-content/uploads/2026/04/Ekonomik-terapi-kampi-1.png" alt="Para Terapi Kampı" width="300" height="375" />
          </a>
          <h2 class="sidebar-title">Son Blog Yazıları</h2>
          {blogs.map((post) => {
            const authorImg = post.author?.profilePhoto ? resolveMediaUrl(post.author.profilePhoto.url) : null;
            return (
              <a href={`/blog/${post.slug}`} class="sidebar-post">
                <div class="sidebar-post-thumb-wrapper">
                  {authorImg
                    ? <img src={authorImg} alt={post.author?.name ?? 'Yazar'} width={56} height={56} />
                    : <div class="sidebar-post-thumb-placeholder">✍️</div>
                  }
                </div>
                <div class="sidebar-post-content">
                  {post.author && (
                    <p class="sidebar-post-author">{post.author.name}</p>
                  )}
                  <p class="sidebar-post-title">{post.title}</p>
                  {post.publishedAt && (
                    <p class="sidebar-post-date">{formatDate(post.publishedAt)}</p>
                  )}
                </div>
              </a>
            );
          })}
          {blogs.length === 0 && <p style="font-size:0.85rem;color:rgb(var(--gray));text-align:center;">Henüz yazı yok.</p>}
          <a href="/blog" class="sidebar-more">Tüm Yazılar →</a>
        </aside>
      </div>
    </main>
    <Footer />

    <script>
      const btn = document.getElementById('load-more-btn');
      const items = document.querySelectorAll('#news-grid .news-item');
      let shown = 20;
      const batch = 10;

      function showNext() {
        const end = Math.min(shown + batch, items.length);
        for (let i = shown; i < end; i++) {
          (items[i] as HTMLElement).style.display = 'block';
        }
        shown = end;
        if (shown >= items.length && btn) {
          btn.style.display = 'none';
        }
      }

      if (btn) {
        btn.addEventListener('click', showNext);
      }
    </script>
  </body>
</html>
