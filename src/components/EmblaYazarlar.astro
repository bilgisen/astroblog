---
import { resolveMediaUrl } from '../lib/payload';
import type { BlogItem } from '../lib/payload';

interface Props {
  blogs: BlogItem[];
}

const { blogs } = Astro.props;
---

{blogs && blogs.length > 0 && (
  <section class="yazarlar-slider-section">
    <div class="yazarlar-slider" id="embla-yazarlar">
      <div class="embla__viewport">
        <div class="embla__container">
          {blogs.map((post) => {
            const itemImg = post.featuredImage
              ? resolveMediaUrl(post.featuredImage.url)
              : post.author?.profilePhoto
                ? resolveMediaUrl(post.author.profilePhoto.url)
                : null;
            return (
              <div class="embla__slide">
                <a href={`/yazarlar/${post.slug}`} class="slide-link">
                  <div class="image-wrapper">
                    {itemImg ? (
                      <img src={itemImg} alt={post.featuredImage?.alt ?? post.title} loading="lazy" />
                    ) : (
                      <div class="no-img">✍️</div>
                    )}
                    <div class="slide-overlay"></div>
                  </div>
                  <div class="slide-content">
                    {post.author && (
                      <span class="slide-author">{post.author.name} yazıyor</span>
                    )}
                    <h3 class="slide-title">{post.title}</h3>
                  </div>
                </a>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Navigation Buttons -->
      <button class="embla__button embla__button--prev" aria-label="Önceki">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="embla__button embla__button--next" aria-label="Sonraki">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <!-- Author photo thumbnails -->
    <div class="thumb-nav">
      {blogs.map((post, index) => {
        const authorImg = post.author?.profilePhoto ? resolveMediaUrl(post.author.profilePhoto.url) : null;
        return (
          <button class={`thumb-nav-item ${index === 0 ? 'is-active' : ''}`} data-index={index} aria-label={post.author?.name ?? post.title}>
            <div class="thumb-border"></div>
            <div class="thumb-photo-wrap">
              {authorImg ? (
                <img src={authorImg} alt={post.author?.name ?? 'Yazar'} class="thumb-photo" loading="lazy" />
              ) : (
                <span class="thumb-photo thumb-photo-placeholder">✍️</span>
              )}
            </div>
          </button>
        );
      })}
    </div>
  </section>
)}

<style>
  .yazarlar-slider-section {
    margin-bottom: 2.5rem;
  }

  .yazarlar-slider {
    position: relative;
    width: 100%;
  }

  .embla__viewport {
    overflow: hidden;
    width: 100%;
  }

  .embla__container {
    display: flex;
  }

  .embla__slide {
    flex: 0 0 100%;
    min-width: 0;
    position: relative;
  }

  .slide-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
  }

  .image-wrapper {
    width: 100%;
    aspect-ratio: 2 / 1;
    position: relative;
    overflow: hidden;
    background: #111;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .slide-link:hover .image-wrapper img {
    transform: scale(1.03);
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.35) 45%,
      rgba(var(--primary-rgb), 0.5) 100%
    );
    z-index: 1;
  }

  .no-img {
    width: 100%;
    height: 100%;
    background: #222;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
  }

  .slide-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 2.5rem 2rem;
    box-sizing: border-box;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    pointer-events: none;
  }

  .slide-author {
    align-self: flex-start;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: var(--primary);
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    box-shadow: 0 4px 10px rgba(var(--primary-rgb), 0.3);
    opacity: 0.95;
  }

  .slide-title {
    font-size: 1.9rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.03em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 2px 15px rgba(0, 0, 0, 0.6);
  }

  .embla__button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    opacity: 0;
    transition: all 0.3s ease;
    padding: 0;
  }

  .yazarlar-slider:hover .embla__button {
    opacity: 1;
  }

  .embla__button:hover {
    background: var(--primary);
    border-color: var(--primary);
  }

  .embla__button--prev { left: 10px; }
  .embla__button--next { right: 10px; }

  .thumb-nav {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .thumb-nav-item {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    outline: none;
  }

  .thumb-border {
    width: 100%;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
  }

  .thumb-nav-item.is-active .thumb-border {
    background: var(--primary);
  }

  .thumb-photo-wrap {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 0;
    overflow: hidden;
    border: 2px solid var(--border);
    transition: border-color 0.3s ease;
    background: var(--border);
  }

  .thumb-nav-item:hover .thumb-photo-wrap,
  .thumb-nav-item.is-active .thumb-photo-wrap {
    border-color: var(--primary);
  }

  .thumb-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thumb-photo-placeholder {
    background: var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }

  /* Desktop only */
  @media (max-width: 960px) {
    .slide-title {
      font-size: 1.5rem;
    }
    .slide-content {
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .yazarlar-slider-section {
      display: none;
    }
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel';

  function initYazarlarSlider() {
    const slider = document.getElementById('embla-yazarlar');
    if (!slider) return;

    const viewportNode = slider.querySelector('.embla__viewport') as HTMLElement;
    if (!viewportNode) return;
    if (viewportNode.dataset.emblaInit === 'true') return;
    viewportNode.dataset.emblaInit = 'true';

    const thumbNodes = document.querySelectorAll('.yazarlar-slider-section .thumb-nav-item');
    const prevBtn = slider.querySelector('.embla__button--prev') as HTMLButtonElement;
    const nextBtn = slider.querySelector('.embla__button--next') as HTMLButtonElement;

    const emblaApi = EmblaCarousel(viewportNode, {
      loop: true,
      duration: 30,
    });

    if (prevBtn) prevBtn.addEventListener('click', () => emblaApi.scrollPrev());
    if (nextBtn) nextBtn.addEventListener('click', () => emblaApi.scrollNext());

    // Author photo thumbnails (hover/click)
    thumbNodes.forEach((thumb, index) => {
      thumb.addEventListener('mouseenter', () => emblaApi.scrollTo(index));
      thumb.addEventListener('click', () => emblaApi.scrollTo(index));
    });

    emblaApi.on('select', () => {
      const activeIndex = emblaApi.selectedScrollSnap();
      thumbNodes.forEach((thumb, idx) => {
        if (idx === activeIndex) thumb.classList.add('is-active');
        else thumb.classList.remove('is-active');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initYazarlarSlider);
  document.addEventListener('astro:page-load', initYazarlarSlider);
</script>
