---
// TickerMarquee.astro
---

<div class="ticker-wrapper" id="financial-ticker">
  <div class="ticker-content" id="ticker-content">
    <div class="ticker-placeholder">Piyasalar Yükleniyor...</div>
  </div>
</div>

<style>
  .ticker-wrapper {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: var(--card);
    border-top: 1px solid var(--border);
    color: var(--foreground);
    height: 40px;
    display: flex;
    align-items: center;
    overflow: hidden;
    z-index: 100;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.05);
  }

  .ticker-content {
    display: flex;
    white-space: nowrap;
    width: max-content;
    will-change: transform;
    animation: marquee 40s linear infinite;
  }

  .ticker-content:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  :global(.ticker-item) {
    display: inline-flex;
    align-items: center;
    padding: 0 1.5rem;
    gap: 0.5rem;
    border-right: 1px solid var(--border);
  }

  :global(.ticker-label) {
    color: var(--muted-foreground);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  :global(.ticker-price) {
    color: var(--foreground);
    font-weight: 700;
  }

  :global(.ticker-diff) {
    font-weight: 700;
  }
  
  :global(.ticker-diff.positive) {
    color: #10b981; /* Emerald */
  }

  :global(.ticker-diff.negative) {
    color: #ef4444; /* Red */
  }

  :global(.ticker-diff.neutral) {
    color: var(--muted-foreground);
  }

  .ticker-placeholder {
    padding: 0 2rem;
    color: var(--muted-foreground);
  }
</style>

<script>
  async function fetchTickerData() {
    try {
      const response = await fetch('https://finveri-cbe8c089.fastapicloud.dev/instruments/market-summary', {
        headers: { 'accept': 'application/json' }
      });
      const data = await response.json();
      
      if (data && data.data) {
        const items = data.data.sort((a: any, b: any) => a.display_order - b.display_order);
        
        let html = '';
        items.forEach((item: any) => {
          let diffClass = 'neutral';
          let diffSign = '';
          if (item.diff_percent > 0) {
            diffClass = 'positive';
            diffSign = '+';
          } else if (item.diff_percent < 0) {
            diffClass = 'negative';
          }
          
          const diffText = item.diff_percent !== 0 ? `${diffSign}${item.diff_percent.toFixed(2)}%` : '0.00%';
          const price = item.last_price > 1000 ? item.last_price.toLocaleString('tr-TR', { maximumFractionDigits: 2 }) : item.last_price.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
          
          html += `
            <div class="ticker-item">
              <span class="ticker-label">${item.label}</span>
              <span class="ticker-price">${price}</span>
              <span class="ticker-diff ${diffClass}">${diffText}</span>
            </div>
          `;
        });
        
        const container = document.getElementById('ticker-content');
        if (container) {
          container.innerHTML = html + html;
        }
      }
    } catch (error) {
      console.error('Ticker error:', error);
    }
  }

  fetchTickerData();
  setInterval(fetchTickerData, 60000);
</script>
