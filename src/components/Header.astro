---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
---

<header>
	<nav>
		<a href="/" class="logo-link">
			<Logo />
		</a>
		<div class="header-right">
			<div class="internal-links">
				<HeaderLink href="/">Anasayfa</HeaderLink>
				<HeaderLink href="/haberler">Haberler</HeaderLink>
				<HeaderLink href="/blog">Yazarlar</HeaderLink>
			</div>
			<div class="social-links">
				<!-- X (Twitter) -->
				<a href="https://twitter.com/paraanaliz" target="_blank" rel="noopener noreferrer" title="@paraanaliz">
					<span class="sr-only">Para Analiz X (Twitter) @paraanaliz</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
						<path fill="currentColor" d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/>
					</svg>
				</a>
				<!-- YouTube -->
				<a href="https://www.youtube.com/channel/UCURPZbLYwqxOtqmkbMfhYOw" target="_blank" rel="noopener noreferrer">
					<span class="sr-only">Para Analiz YouTube</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
						<path fill="currentColor" d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.007 2.007 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.007 2.007 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31.4 31.4 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.007 2.007 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A99.788 99.788 0 0 1 7.858 2h.193zM6.4 5.209v4.818l4.157-2.408z"/>
					</svg>
				</a>
			</div>
			<a href="https://pamagaza.com/" class="register-btn" target="_blank" rel="noopener noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
					<circle cx="12" cy="7" r="4"/>
				</svg>
				<span>Üye Olun</span>
			</a>
			<button id="mobile-menu-toggle" class="mobile-menu-btn" aria-label="Menü">
				<svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>
		</div>
	</nav>
	<!-- Mobile Menu Overlay -->
	<div id="mobile-menu" class="mobile-menu-overlay">
		<div class="mobile-menu-content">
			<HeaderLink href="/">Anasayfa</HeaderLink>
			<HeaderLink href="/haberler">Haberler</HeaderLink>
			<HeaderLink href="/blog">Yazarlar</HeaderLink>
			<hr />
			<div class="mobile-socials">
				<a href="https://twitter.com/paraanaliz" target="_blank">X (Twitter)</a>
				<a href="https://www.youtube.com/channel/UCURPZbLYwqxOtqmkbMfhYOw" target="_blank">YouTube</a>
			</div>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('mobile-menu-toggle');
	const menu = document.getElementById('mobile-menu');
	
	toggle?.addEventListener('click', () => {
		menu?.classList.toggle('active');
		document.body.classList.toggle('overflow-hidden');
	});
</script>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid var(--border);
	}
	:global(.dark) header {
		background: rgba(21, 21, 21, 0.8);
	}
	.logo-link {
		text-decoration: none;
		display: flex;
		align-items: center;
		transition: opacity 0.2s ease;
	}
	.logo-link:hover {
		opacity: 0.8;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		height: 4.5rem;
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.internal-links {
		display: flex;
		gap: 0.5rem;
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		border-right: 1px solid var(--border);
		padding-right: 1rem;
	}
	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--muted-foreground);
		transition: all 0.2s ease;
		padding: 0.5rem;
		border-radius: 8px;
	}
	.social-links a:hover {
		color: var(--primary);
		background: var(--muted);
	}
	.register-btn {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--primary);
		color: var(--primary-foreground);
		padding: 0.6rem 1.25rem;
		border-radius: 99px;
		font-weight: 700;
		font-size: 0.9rem;
		text-decoration: none;
		transition: all 0.2s ease;
		box-shadow: 0 4px 10px rgba(from var(--primary) l c h / 0.2);
	}
	.register-btn:hover {
		opacity: 0.9;
		transform: translateY(-1px);
	}
	.mobile-menu-btn {
		display: none;
		background: none;
		border: none;
		color: var(--foreground);
		cursor: pointer;
		padding: 0.5rem;
	}
	
	/* Mobile Menu Guru Solution */
	.mobile-menu-overlay {
		position: fixed;
		inset: 0;
		background: var(--background);
		z-index: 1000; /* High z-index to stay on top */
		display: flex;
		flex-direction: column;
		padding: 6rem 2rem 2rem;
		opacity: 0;
		visibility: hidden;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		transform: translateY(-10px);
	}
	.mobile-menu-overlay.active {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.mobile-menu-content {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		width: 100%;
	}
	.mobile-menu-content a {
		font-size: 2.25rem;
		font-weight: 800;
		color: var(--foreground);
		text-decoration: none;
		letter-spacing: -0.04em;
		transition: color 0.2s;
	}
	.mobile-menu-content a:hover {
		color: var(--primary);
	}
	.mobile-socials {
		margin-top: auto;
		display: flex;
		gap: 2rem;
		padding-top: 3rem;
		border-top: 1px solid var(--border);
	}
	.mobile-socials a {
		font-size: 1rem;
		font-weight: 700;
		color: var(--muted-foreground);
		text-decoration: none;
	}

	@media (max-width: 900px) {
		.internal-links, .social-links {
			display: none;
		}
		.mobile-menu-btn {
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
			z-index: 1001; /* Above overlay */
		}
		.header-right {
			gap: 0.75rem;
		}
		.register-btn span {
			display: none;
		}
		.register-btn {
			padding: 0.6rem;
		}
		nav {
			height: 4rem;
		}
		header {
			padding: 0 1rem;
		}
	}
</style>
