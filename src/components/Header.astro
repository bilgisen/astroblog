---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Anasayfa</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
		<div class="social-links">
			<!-- X (Twitter) -->
			<a href="https://twitter.com/paraanaliz" target="_blank" rel="noopener noreferrer" title="@paraanaliz">
				<span class="sr-only">Para Analiz X (Twitter) @paraanaliz</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28">
					<path fill="currentColor" d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"/>
				</svg>
			</a>
			<!-- YouTube -->
			<a href="https://www.youtube.com/channel/UCURPZbLYwqxOtqmkbMfhYOw" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Para Analiz YouTube</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28">
					<path fill="currentColor" d="M8.051 1.999h.089c.822.003 4.987.033 6.11.335a2.01 2.01 0 0 1 1.415 1.42c.101.38.172.883.22 1.402l.01.104.022.26.008.104c.065.914.073 1.77.074 1.957v.075c-.001.194-.01 1.108-.082 2.06l-.008.105-.009.104c-.05.572-.124 1.14-.235 1.558a2.007 2.007 0 0 1-1.415 1.42c-1.16.312-5.569.334-6.18.335h-.142c-.309 0-1.587-.006-2.927-.052l-.17-.006-.087-.004-.171-.007-.171-.007c-1.11-.049-2.167-.128-2.654-.26a2.007 2.007 0 0 1-1.415-1.419c-.111-.417-.185-.986-.235-1.558L.09 9.82l-.008-.104A31.4 31.4 0 0 1 0 7.68v-.123c.002-.215.01-.958.064-1.778l.007-.103.003-.052.008-.104.022-.26.01-.104c.048-.519.119-1.023.22-1.402a2.007 2.007 0 0 1 1.415-1.42c.487-.13 1.544-.21 2.654-.26l.17-.007.172-.006.086-.003.171-.007A99.788 99.788 0 0 1 7.858 2h.193zM6.4 5.209v4.818l4.157-2.408z"/>
				</svg>
			</a>
			<!-- Profile / Mağaza -->
			<a href="https://pamagaza.com/" target="_blank" rel="noopener noreferrer" title="Para Analiz Mağaza">
				<span class="sr-only">Para Analiz Mağaza</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="12" cy="8" r="4"/>
					<path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid rgba(0, 0, 0, 0.05);
	}
	h2 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 800;
		letter-spacing: -0.04em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--primary);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		height: 4rem;
	}
	nav a {
		padding: 0.5rem 1rem;
		color: var(--foreground);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		transition: all 0.2s ease;
		border-radius: 8px;
	}
	nav a:hover {
		background: rgba(0, 0, 0, 0.05);
		color: var(--primary);
	}
	nav a.active {
		color: var(--primary);
		background: oklch(from var(--primary) l c h / 0.1);
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--muted-foreground);
		transition: all 0.2s ease;
		padding: 0.5rem;
		border-radius: 50%;
	}
	.social-links a:hover {
		color: var(--primary);
		background: rgba(0, 0, 0, 0.05);
		transform: scale(1.1);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
