---
import { resolveMediaUrl } from '../lib/payload';
import type { NewsItem } from '../lib/payload';

interface Props {
  slides: NewsItem[];
}

const { slides } = Astro.props;
---

{slides && slides.length > 0 && (
  <div class="main-slider-container">
    <div class="main-slider" id="main-slider">
      <!-- Upper Main Slider viewport -->
      <div class="embla__viewport">
        <div class="embla__container">
          {slides.map((item, index) => {
            const imgUrl = item.featuredImage ? resolveMediaUrl(item.featuredImage.url) : null;
            return (
              <div class="embla__slide">
                <a href={`/haberler/${item.slug}`} class="slide-link">
                  <div class="image-wrapper">
                    {imgUrl ? (
                      <img src={imgUrl} alt={item.featuredImage?.alt ?? item.title} loading={index === 0 ? "eager" : "lazy"} />
                    ) : (
                      <div class="no-img">📰</div>
                    )}
                    <div class="slide-overlay"></div>
                  </div>
                  <div class="slide-content">
                    {item.category && (
                      <span class="slide-category">{item.category.name}</span>
                    )}
                    <h2 class="slide-title">{item.title}</h2>
                  </div>
                </a>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Chevron buttons for Web -->
      <button class="embla__prev" aria-label="Önceki">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="embla__next" aria-label="Sonraki">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="chevron-icon"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>

      <!-- Dots navigation for Mobile -->
      <div class="embla__dots"></div>
    </div>

    <!-- Thumbnail navigation for Web -->
    <div class="thumb-nav">
      {slides.map((item, index) => {
        return (
          <button class={`thumb-nav-item ${index === 0 ? 'is-active' : ''}`} data-index={index}>
            <div class="thumb-border"></div>
            <div class="thumb-content">
              <span class="thumb-num">{String(index + 1).padStart(2, '0')}</span>
              <span class="thumb-title">{item.title}</span>
            </div>
          </button>
        );
      })}
    </div>
  </div>
)}

<style>
  /* Container layout */
  .main-slider-container {
    width: 100%;
    margin: 0 auto 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Slider Frame */
  .main-slider {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 1;
    border-radius: 16px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  /* Embla setups */
  .embla__viewport {
    overflow: hidden;
    width: 100%;
    height: 100%;
  }

  .embla__container {
    display: flex;
    height: 100%;
    will-change: transform;
  }

  .embla__slide {
    flex: 0 0 100%;
    min-width: 0;
    position: relative;
    height: 100%;
  }

  /* Slide links and elements */
  .slide-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
  }

  .image-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .slide-link:hover .image-wrapper img {
    transform: scale(1.03);
  }

  .slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.35) 60%,
      rgba(0, 0, 0, 0) 100%
    );
    z-index: 1;
  }

  /* Content Overlay */
  .slide-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 3rem 2.5rem;
    box-sizing: border-box;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    pointer-events: none;
  }

  .slide-category {
    align-self: flex-start;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: var(--primary);
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    box-shadow: 0 4px 10px rgba(var(--primary-rgb), 0.3);
  }

  .slide-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.03em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  /* Chevrons */
  .embla__prev,
  .embla__next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s ease;
    backdrop-filter: none;
  }

  .embla__prev:hover,
  .embla__next:hover {
    background: transparent;
    color: #fff;
    transform: translateY(-50%) scale(1.2);
  }

  .embla__prev {
    left: 1.5rem;
  }

  .embla__next {
    right: 1.5rem;
  }

  .chevron-icon {
    width: 32px;
    height: 32px;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
  }

  /* Dot Nav (Mobile) */
  .embla__dots {
    display: none;
  }

  /* Thumbnails (Desktop) */
  .thumb-nav {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 0.5rem;
    width: 100%;
  }

  .thumb-nav-item {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    outline: none;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .thumb-nav-item:hover,
  .thumb-nav-item.is-active {
    opacity: 1;
  }

  .thumb-border {
    width: 100%;
    height: 3px;
    background: var(--border);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .thumb-nav-item.is-active .thumb-border {
    background: var(--primary);
  }

  .thumb-content {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0 0.25rem;
  }

  .thumb-num {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--primary);
    font-family: var(--font-mono, monospace);
    letter-spacing: -0.02em;
  }

  .thumb-title {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Placeholder img style */
  .no-img {
    width: 100%;
    height: 100%;
    background: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
  }

  /* Responsive styling */
  @media (max-width: 960px) {
    .slide-title {
      font-size: 1.75rem;
    }
    .slide-content {
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 768px) {
    /* Mobile dikey 3:4 orani */
    .main-slider {
      aspect-ratio: 3 / 4;
      border-radius: 12px;
    }

    /* Hide arrows on mobile */
    .embla__prev,
    .embla__next {
      display: none;
    }

    /* Hide desktop thumbnail bar */
    .thumb-nav {
      display: none;
    }

    /* Show Mobile Indicator Lines */
    .embla__dots {
      display: flex;
      justify-content: center;
      gap: 0.35rem;
      position: absolute;
      bottom: 1.25rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      width: 100%;
      padding: 0 1rem;
      box-sizing: border-box;
    }

    :global(.embla__dot) {
      flex: 1;
      max-width: 40px;
      height: 3px;
      background: rgba(255, 255, 255, 0.35);
      border: none;
      border-radius: 2px;
      padding: 0;
      cursor: pointer;
      transition: background 0.3s ease, flex-grow 0.3s ease;
    }

    :global(.embla__dot.is-active) {
      background: var(--primary);
    }

    .slide-content {
      padding: 2.5rem 1.25rem 2.5rem;
    }

    .slide-title {
      font-size: 1.5rem;
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .image-wrapper img {
      object-fit: cover;
      object-position: center 30%; /* Smart crop positioning for vertical screens */
    }
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel';

  function initSlider() {
    const mainSlider = document.getElementById('main-slider');
    if (!mainSlider) return;

    const viewportNode = mainSlider.querySelector('.embla__viewport') as HTMLElement;
    const thumbNodes = document.querySelectorAll('.thumb-nav-item');
    const dotContainer = mainSlider.querySelector('.embla__dots') as HTMLElement;
    const prevBtn = mainSlider.querySelector('.embla__prev') as HTMLElement;
    const nextBtn = mainSlider.querySelector('.embla__next') as HTMLElement;

    if (!viewportNode) return;

    const emblaApi = EmblaCarousel(viewportNode, {
      loop: true,
      duration: 30,
      skipSnaps: false,
    });

    // Autoplay logic
    let autoplayInterval: any;
    const startAutoplay = () => {
      stopAutoplay();
      autoplayInterval = setInterval(() => {
        if (emblaApi.canScrollNext()) {
          emblaApi.scrollNext();
        } else {
          emblaApi.scrollTo(0);
        }
      }, 6000);
    };

    const stopAutoplay = () => {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
      }
    };

    emblaApi.on('init', startAutoplay);
    emblaApi.on('pointerDown', stopAutoplay);
    emblaApi.on('pointerUp', startAutoplay);

    // Manual navigation buttons
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        emblaApi.scrollPrev();
        startAutoplay();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        emblaApi.scrollNext();
        startAutoplay();
      });
    }

    // Thumbnails (Web hover/click)
    thumbNodes.forEach((thumb, index) => {
      thumb.addEventListener('mouseenter', () => {
        emblaApi.scrollTo(index);
        startAutoplay();
      });
      thumb.addEventListener('click', () => {
        emblaApi.scrollTo(index);
        startAutoplay();
      });
    });

    // Mobile Dots
    const dotNodes: HTMLElement[] = [];
    if (dotContainer) {
      dotContainer.innerHTML = '';
      const slideCount = emblaApi.slideNodes().length;
      for (let i = 0; i < slideCount; i++) {
        const dot = document.createElement('button');
        dot.className = `embla__dot ${i === 0 ? 'is-active' : ''}`;
        dot.ariaLabel = `Slayt ${i + 1}`;
        dot.addEventListener('click', () => {
          emblaApi.scrollTo(i);
          startAutoplay();
        });
        dotContainer.appendChild(dot);
        dotNodes.push(dot);
      }
    }

    // Sync Active Indicators
    emblaApi.on('select', () => {
      const activeIndex = emblaApi.selectedScrollSnap();

      // Update Thumbnails
      thumbNodes.forEach((thumb, idx) => {
        if (idx === activeIndex) {
          thumb.classList.add('is-active');
        } else {
          thumb.classList.remove('is-active');
        }
      });

      // Update Dots
      dotNodes.forEach((dot, idx) => {
        if (idx === activeIndex) {
          dot.classList.add('is-active');
        } else {
          dot.classList.remove('is-active');
        }
      });
    });

    // Start on mount
    startAutoplay();
  }

  // Support both normal load and view transitions/SPA routers if any
  document.addEventListener('DOMContentLoaded', initSlider);
  document.addEventListener('astro:page-load', initSlider);
</script>
