---
---

<div class="flex items-center justify-center gap-2 py-8 border-t border-border mt-8">
  <button
    id="theme-light"
    class="p-2 rounded-full hover:bg-muted transition-colors text-muted-foreground hover:text-foreground"
    title="Aydınlık Mod"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M22 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
  </button>
  <button
    id="theme-dark"
    class="p-2 rounded-full hover:bg-muted transition-colors text-muted-foreground hover:text-foreground"
    title="Karanlık Mod"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </button>
  <button
    id="theme-system"
    class="p-2 rounded-full hover:bg-muted transition-colors text-muted-foreground hover:text-foreground"
    title="Sistem Teması"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
  </button>
</div>

<script>
  const themes = ['light', 'dark', 'system'];
  
  const getTheme = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return 'system';
  };

  const setTheme = (theme: string) => {
    const root = document.documentElement;
    if (theme === 'system') {
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      root.classList.toggle('dark', systemTheme === 'dark');
    } else {
      root.classList.toggle('dark', theme === 'dark');
    }
    localStorage.setItem('theme', theme);
  };

  themes.forEach(theme => {
    const btn = document.getElementById(`theme-${theme}`);
    btn?.addEventListener('click', () => setTheme(theme));
  });

  // Initialize
  setTheme(getTheme() || 'system');
</script>
