  <svg
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-8 h-8"
  >
    <path
      d="M16 4L28 24H4L16 4Z"
      fill="currentColor"
      class="text-primary"
    />
  </svg>
  <span class="font-extrabold text-xl tracking-tighter text-foreground">
    PARA<span class="text-primary">ANALİZ</span>
  </span>
</div>
