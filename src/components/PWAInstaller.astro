---
// PWAInstaller.astro - PWA registration and install banner component
---

<!-- Beautiful PWA Install Banner -->
<div id="pwa-install-banner" class="pwa-banner hidden" role="dialog" aria-labelledby="pwa-title" aria-describedby="pwa-desc">
  <div class="pwa-content">
    <button id="pwa-close-btn" class="pwa-close" aria-label="Kapat">
      <svg viewBox="0 0 24 24" width="20" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    
    <div class="pwa-info-row">
      <div class="pwa-icon-wrapper">
        <img src="/icon-192.png" alt="ParaAnaliz Logo" class="pwa-app-icon" width="64" height="64" />
      </div>
      <div class="pwa-text-wrapper">
        <h3 id="pwa-title" class="pwa-app-title">ParaAnaliz</h3>
        <p id="pwa-desc" class="pwa-app-desc">Mobil Uygulamamızı hemen yükleyin, ekonomi gündemini anlık takip edin.</p>
      </div>
    </div>
    
    <div class="pwa-actions-row">
      <button id="pwa-dismiss-btn" class="pwa-btn pwa-btn-secondary">Daha Sonra</button>
      <button id="pwa-install-btn" class="pwa-btn pwa-btn-primary">Hemen Yükle</button>
    </div>
  </div>
</div>

<style>
  /* ── PWA Banner Container ── */
  .pwa-banner {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%) translateY(120px);
    width: calc(100% - 32px);
    max-width: 440px;
    z-index: 10000;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
    opacity: 0;
    pointer-events: none;
  }

  .pwa-banner.visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .pwa-banner.hidden {
    display: none;
  }

  /* ── Rich Glassmorphic Design ── */
  .pwa-content {
    position: relative;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 20px;
    padding: 1.5rem;
    box-shadow: 
      0 10px 40px -10px rgba(0, 131, 176, 0.15),
      0 1px 1px rgba(255, 255, 255, 0.8) inset,
      0 0 0 1px rgba(0, 0, 0, 0.03);
    overflow: hidden;
  }

  :global(.dark) .pwa-content {
    background: rgba(30, 30, 35, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 
      0 10px 40px -10px rgba(0, 0, 0, 0.5),
      0 1px 1px rgba(255, 255, 255, 0.05) inset,
      0 0 0 1px rgba(255, 255, 255, 0.02);
  }

  /* Close Button */
  .pwa-close {
    position: absolute;
    top: 14px;
    right: 14px;
    background: transparent;
    border: none;
    color: var(--muted-foreground);
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    opacity: 0.6;
  }

  .pwa-close:hover {
    background: rgba(0, 0, 0, 0.05);
    color: var(--foreground);
    opacity: 1;
  }

  :global(.dark) .pwa-close:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* Info Row */
  .pwa-info-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-right: 1rem;
  }

  .pwa-icon-wrapper {
    flex-shrink: 0;
  }

  .pwa-app-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    object-fit: cover;
    box-shadow: 
      0 4px 12px rgba(0, 131, 176, 0.2),
      0 0 0 1px rgba(0, 0, 0, 0.05);
    display: block;
    animation: bounceSlow 3s infinite ease-in-out;
  }

  .pwa-text-wrapper {
    flex: 1;
    min-width: 0;
  }

  .pwa-app-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--foreground);
    margin: 0 0 0.2rem 0;
    letter-spacing: -0.02em;
  }

  .pwa-app-desc {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--muted-foreground);
    margin: 0;
    font-weight: 500;
  }

  /* Actions Row */
  .pwa-actions-row {
    display: flex;
    gap: 0.75rem;
  }

  .pwa-btn {
    flex: 1;
    padding: 0.75rem 1rem;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
    border: none;
    outline: none;
  }

  .pwa-btn-primary {
    background: #0083b0;
    color: #ffffff;
    box-shadow: 0 4px 12px rgba(0, 131, 176, 0.25);
  }

  .pwa-btn-primary:hover {
    background: #007299;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(0, 131, 176, 0.35);
  }

  .pwa-btn-primary:active {
    transform: translateY(0);
  }

  .pwa-btn-secondary {
    background: var(--muted);
    color: var(--muted-foreground);
    border: 1px solid var(--border);
  }

  .pwa-btn-secondary:hover {
    background: var(--border);
    color: var(--foreground);
  }

  /* ── Micro-animations ── */
  @keyframes bounceSlow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }

  /* Mobile adjustment */
  @media (max-width: 480px) {
    .pwa-banner {
      bottom: 16px;
      width: calc(100% - 24px);
    }
    .pwa-content {
      padding: 1.2rem;
      border-radius: 18px;
    }
    .pwa-app-title {
      font-size: 1.05rem;
    }
    .pwa-app-desc {
      font-size: 0.8rem;
    }
  }
</style>

<script is:inline>
  // This part must be inline to catch the event immediately as the page loads
  window.addEventListener('beforeinstallprompt', (e) => {
    console.log('PWA: beforeinstallprompt caught (inline)');
    e.preventDefault();
    window.deferredPWAInstallPrompt = e;
    window.dispatchEvent(new CustomEvent('pwa-prompt-ready'));
  });
</script>

<script>
  let showBannerPending = false;

  // 1. Service Worker Registration
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js')
        .then((reg) => {
          console.log('PWA: SW registered');
          
          reg.addEventListener('updatefound', () => {
            const installingWorker = reg.installing;
            if (installingWorker) {
              installingWorker.addEventListener('statechange', () => {
                if (installingWorker.state === 'installed' && navigator.serviceWorker.controller) {
                  window.location.reload();
                }
              });
            }
          });
        });

      let refreshing = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (refreshing) return;
        refreshing = true;
        window.location.reload();
      });
    });
  }

  function isStandalone() {
    return (
      window.matchMedia('(display-mode: standalone)').matches ||
      (window.navigator as any).standalone ||
      document.referrer.includes('android-app://')
    );
  }

  async function checkIfInstalled() {
    if (isStandalone()) return true;
    if ('getInstalledRelatedApps' in navigator) {
      try {
        const relatedApps = await (navigator as any).getInstalledRelatedApps();
        return relatedApps.some((app: any) => app.platform === 'webapp');
      } catch (err) {
        return false;
      }
    }
    return localStorage.getItem('pwa_installed') === 'true';
  }

  // Handle the ready event from inline script or check if already caught
  function handlePromptReady() {
    console.log('PWA: Prompt ready, checking visibility conditions...');
    
    const dismissedTime = localStorage.getItem('pwa_prompt_dismissed_time');
    // Set to 24 hours for better visibility during active development/testing
    const isDismissedRecently = dismissedTime && (Date.now() - parseInt(dismissedTime, 10) < 24 * 60 * 60 * 1000); 

    if (isDismissedRecently) {
      console.log('PWA: Banner recently dismissed, skipping.');
      return;
    }

    const banner = document.getElementById('pwa-install-banner');
    if (banner) {
      showBanner(banner);
    } else {
      showBannerPending = true;
    }
  }

  window.addEventListener('pwa-prompt-ready', handlePromptReady);

  // Helper to show the banner
  async function showBanner(banner: HTMLElement) {
    const isInstalled = await checkIfInstalled();
    if (isInstalled) {
      console.log('PWA: Already installed, not showing banner.');
      return;
    }

    // Small delay to ensure page is visually ready
    setTimeout(() => {
      banner.classList.remove('hidden');
      banner.offsetHeight; // force reflow
      banner.classList.add('visible');
      console.log('PWA: Banner visible now.');
    }, 1500);
  }

  function hideBanner(banner: HTMLElement) {
    banner.classList.remove('visible');
    setTimeout(() => {
      banner.classList.add('hidden');
    }, 500);
  }

  async function initPWAInstaller() {
    const banner = document.getElementById('pwa-install-banner');
    const installBtn = document.getElementById('pwa-install-btn');
    const dismissBtn = document.getElementById('pwa-dismiss-btn');
    const closeBtn = document.getElementById('pwa-close-btn');

    if (!banner) return;

    if (showBannerPending || (window as any).deferredPWAInstallPrompt) {
      handlePromptReady();
    }

    if (installBtn) {
      installBtn.addEventListener('click', async () => {
        const prompt = (window as any).deferredPWAInstallPrompt;
        if (!prompt) return;
        
        hideBanner(banner);
        prompt.prompt();
        
        const { outcome } = await prompt.userChoice;
        if (outcome === 'accepted') {
          localStorage.setItem('pwa_installed', 'true');
        }
        (window as any).deferredPWAInstallPrompt = null;
      });
    }

    const dismissBanner = () => {
      localStorage.setItem('pwa_prompt_dismissed_time', Date.now().toString());
      hideBanner(banner);
    };

    if (dismissBtn) dismissBtn.addEventListener('click', dismissBanner);
    if (closeBtn) closeBtn.addEventListener('click', dismissBanner);
  }

  window.addEventListener('appinstalled', () => {
    localStorage.setItem('pwa_installed', 'true');
    const banner = document.getElementById('pwa-install-banner');
    if (banner) hideBanner(banner);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPWAInstaller);
  } else {
    initPWAInstaller();
  }
</script>
